(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language push the plate to the front of the stove)
    (:regions
      (plate_region
          (:target main_table)
          (:ranges (
              (0.04 -0.03 0.060000000000000005 -0.01)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (stove_front_region
          (:target main_table)
          (:ranges (
              (-0.09 0.16999999999999998 -0.010000000000000002 0.25)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (stove_region
          (:target main_table)
          (:ranges (
              (-0.42 0.19999999999999998 -0.39999999999999997 0.22)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    main_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    plate_1 - plate
  )

  (:obj_of_interest
    plate_1
  )

  (:init
    (On plate_1 main_table_plate_region)
    (On flat_stove_1 main_table_stove_region)
  )

  (:goal
    (And (On plate_1 main_table_stove_front_region))
  )

)
